# Copy this file to .env and replace every REQUIRED value before starting Docker.
# See docs/configuration.md for variable scope and construction guidance.
# Never commit .env. Never use real production credentials as decoy values.

# Gateway
APP_ENV=development
MIRAGE_INTERNAL_API_URL=http://gateway:8000
FRONTEND_ORIGIN=http://localhost:3000
RISK_THRESHOLD=60
ANOMALY_REDIRECT_CONFIDENCE=0.5
RATE_LIMIT_PER_MINUTE=120
REAL_APP_URL=http://localhost:8001
DECOY_SERVICE_URL=http://localhost:8002
PROXY_TIMEOUT_SECONDS=10
PROXY_MAX_BODY_BYTES=1048576
MIRAGE_MODEL_ARTIFACT=
MIRAGE_MODEL_DATASET_MANIFEST=
MIRAGE_RETRAINING_ARTIFACT_DIR=artifacts/retraining
ML_SHADOW_MONITOR_THRESHOLD=0.35
ML_SHADOW_REDIRECT_THRESHOLD=0.65
ML_PROMOTION_MIN_TOTAL_ROWS=1000
ML_PROMOTION_MIN_ROWS_PER_CLASS=100
ML_PROMOTION_MIN_SHADOW_EVENTS=500
ML_PROMOTION_MIN_AGREEMENT_RATE=0.8
# Routing mode: heuristic (default), hybrid (heuristic+ML), or ml_only.
# Keep heuristic until artifact, dataset, holdout, and shadow evidence are reviewed.
ML_ROUTING_MODE=heuristic
# This second switch prevents accidental model-controlled routing.
ML_LIVE_ROUTING_APPROVED=false

# REQUIRED: operator API key and gateway database connection string.
# DATABASE_URL must use the postgresql+asyncpg driver and Docker host `db`.
# Its user, password, and database must match POSTGRES_* below.
MIRAGE_API_KEY=
DATABASE_URL=

# REQUIRED: operator login and short-lived dashboard stream tickets.
# The password must contain at least 16 characters. Both secrets must contain
# at least 32 random characters. Use the same ticket secret for web and gateway.
MIRAGE_OPERATOR_PASSWORD=
MIRAGE_OPERATOR_SESSION_SECRET=
MIRAGE_DASHBOARD_TICKET_SECRET=
MIRAGE_DASHBOARD_WS_URL=ws://localhost:8000/api/v1/dashboard/ws
# Keep false for local HTTP. Set true for every HTTPS staging/production URL.
MIRAGE_SECURE_COOKIES=false

# Docker Compose / PostgreSQL
POSTGRES_USER=mirage
POSTGRES_DB=mirage
# REQUIRED: use a strong URL-safe value and use the same value in DATABASE_URL.
POSTGRES_PASSWORD=

# REQUIRED: synthetic values exposed only by decoy responses.
# These must never be valid credentials for any real system.
DECOY_LOGIN_TOKEN=
DECOY_OAUTH_TOKEN=
DECOY_SERVICE_TOKEN=
DECOY_CANARY_EPOCH=v1
DECOY_DATABASE_URL=postgresql://db:5432/decoy
