# Project MIRAGE cloud deployment checklist (Supabase + Railway + Vercel)
# Keep actual values in Railway, Vercel, and Supabase dashboards. Do not commit them.
# docs/deployment.md explains every value and the order to set them in.

# --- Railway: gateway (public domain) ---
# Supabase session pooler URL (port 5432) with ?sslmode=require. The
# postgres:// or postgresql:// scheme is fine; the gateway rewrites it.
# The transaction pooler (port 6543) is refused at startup.
APP_ENV=production
DATABASE_URL=
FRONTEND_ORIGIN=
MIRAGE_API_KEY=
MIRAGE_DASHBOARD_TICKET_SECRET=
REAL_APP_URL=http://${{real-app-demo.RAILWAY_PRIVATE_DOMAIN}}:${{real-app-demo.PORT}}
DECOY_SERVICE_URL=http://${{decoy.RAILWAY_PRIVATE_DOMAIN}}:${{decoy.PORT}}
TRUSTED_PROXIES=
ML_ROUTING_MODE=heuristic
ML_LIVE_ROUTING_APPROVED=false
MIRAGE_MODEL_ARTIFACT=
MIRAGE_MODEL_ARTIFACT_SHA256=
MIRAGE_MODEL_DATASET_MANIFEST=

# --- Railway: gateway and decoy (same synthetic values on both) ---
DECOY_LOGIN_TOKEN=
DECOY_OAUTH_TOKEN=
DECOY_SERVICE_TOKEN=
DECOY_CANARY_EPOCH=v1
DECOY_DATABASE_URL=postgresql://synthetic.invalid:5432/decoy

# --- Railway: real-app-demo and decoy (private network only, no domain) ---
# real-app-demo: PORT=8001, decoy: PORT=8002
PORT=
HOST=::

# --- Vercel: web (server-side only, never NEXT_PUBLIC_*) ---
MIRAGE_INTERNAL_API_URL=
MIRAGE_API_KEY=
MIRAGE_DASHBOARD_TICKET_SECRET=
MIRAGE_OPERATOR_SESSION_SECRET=
MIRAGE_DASHBOARD_WS_URL=
MIRAGE_SECURE_COOKIES=true
MIRAGE_TRUST_PROXY_HEADERS=true

# --- Your machine: apps/gateway/scripts/smoke_deploy.py ---
# Export the password with `read -rs`, never on the command line.
SMOKE_GATEWAY_URL=
SMOKE_WEB_URL=
SMOKE_OPERATOR_USERNAME=admin
SMOKE_OPERATOR_PASSWORD=
