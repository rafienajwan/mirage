# Project MIRAGE cloud deployment template
# Keep actual values in Railway, Vercel, and Supabase dashboards. Do not commit them.

# Gateway service on Railway
# Use the Supabase direct URL when Railway supports IPv6. Otherwise use the
# shared session pooler on port 5432. Prefix the URL scheme with
# postgresql+asyncpg:// and keep SSL enabled.
APP_ENV=production
DATABASE_URL=
FRONTEND_ORIGIN=
MIRAGE_API_KEY=
MIRAGE_DASHBOARD_TICKET_SECRET=
REAL_APP_URL=
DECOY_SERVICE_URL=
ML_ROUTING_MODE=heuristic
ML_LIVE_ROUTING_APPROVED=false
MIRAGE_MODEL_ARTIFACT=
MIRAGE_MODEL_DATASET_MANIFEST=

# Shared synthetic decoy values for gateway and decoy services
DECOY_LOGIN_TOKEN=
DECOY_OAUTH_TOKEN=
DECOY_SERVICE_TOKEN=
DECOY_CANARY_EPOCH=v1
DECOY_DATABASE_URL=postgresql://synthetic.invalid:5432/decoy

# Next.js service on Vercel
MIRAGE_INTERNAL_API_URL=
MIRAGE_OPERATOR_PASSWORD=
MIRAGE_OPERATOR_SESSION_SECRET=
MIRAGE_DASHBOARD_WS_URL=
MIRAGE_SECURE_COOKIES=true
