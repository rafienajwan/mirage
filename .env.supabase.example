# Project MIRAGE - Supabase Database Configuration Template
# Use this template when connecting MIRAGE Gateway to a cloud Supabase PostgreSQL database.

# Supabase Transaction Pooler (Port 6543) or Direct Connection (Port 5432)
# Required driver: postgresql+asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:6543/postgres?ssl=require

# Supabase Direct PostgreSQL URL for Alembic Migrations (Port 5432)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres?ssl=require

# Gateway API Keys & Ticket Secrets for Production Cloud Deployment
MIRAGE_API_KEY=YOUR_SECURE_GENERATED_API_KEY_HERE
MIRAGE_DASHBOARD_STREAM_TOKEN=YOUR_SECURE_STREAM_TOKEN_HERE
MIRAGE_DASHBOARD_TICKET_SECRET=YOUR_32_BYTE_HMAC_SECRET_HERE

# Production CORS & WebSocket Origin
FRONTEND_ORIGIN=https://mirage-web.vercel.app

# ML Routing Mode Options: heuristic, hybrid, ml_only
ML_ROUTING_MODE=hybrid
MIRAGE_MODEL_ARTIFACT=artifacts/custom_api_logs/custom_api_risk_model.joblib
MIRAGE_MODEL_DATASET_MANIFEST=data/prepared/custom_api_logs/manifest.json
