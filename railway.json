{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  },
  "services": {
    "gateway": {
      "source": {
        "repo": "rafienajwan/mirage",
        "rootDirectory": "apps/gateway"
      },
      "healthcheckPath": "/health",
      "healthcheckTimeout": 10
    },
    "real-app-demo": {
      "source": {
        "repo": "rafienajwan/mirage",
        "rootDirectory": "apps/real-app-demo"
      },
      "healthcheckPath": "/",
      "healthcheckTimeout": 10
    },
    "decoy": {
      "source": {
        "repo": "rafienajwan/mirage",
        "rootDirectory": "apps/decoy"
      },
      "healthcheckPath": "/health",
      "healthcheckTimeout": 10
    }
  }
}
